# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it's in .gitignore already).
# Run `scripts/generate_secrets.sh` to auto-generate SECRET_KEY and the
# initial admin password hash instead of typing them by hand.

# --- Auth ---
# Random 64-char hex string used to sign JWTs. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_real_secret

# Initial admin login (created on first boot if the users table is empty).
ADMIN_USERNAME=admin
# Plaintext only used once by generate_secrets.sh to produce ADMIN_PASSWORD_HASH below;
# the app itself only ever reads the hash.
# NOTE: docker compose interpolates `$` in .env values, so every `$` in the
# bcrypt hash must be doubled to `$$` (e.g. $2b$12$... -> $$2b$$12$$...) or
# the hash gets silently truncated. generate_secrets.sh / gen_hash.py do this
# escaping for you already — only matters if you paste a hash by hand.
ADMIN_PASSWORD_HASH=changeme_bcrypt_hash

# --- Network ---
# Network interface NetSentinel should monitor (this host's own traffic + LAN discovery).
# Leave empty to auto-detect the active Wi-Fi/Ethernet interface at startup.
NETSENTINEL_IFACE=

# CIDR of the LAN to scan for device discovery (e.g. 192.168.1.0/24).
# Leave empty to auto-detect from the interface's IP + netmask.
NETSENTINEL_LAN_CIDR=

# --- App ---
NETSENTINEL_ENV=development
NETSENTINEL_LOG_LEVEL=info
NETSENTINEL_DB_PATH=/data/netsentinel.db

# Containers run with network_mode: host (so Suricata/scapy/nmap can see the
# real network interface), which means ports bind directly on this machine
# and can't be remapped via docker-compose `ports:`. Fixed ports:
#   dashboard -> http://<this-machine-ip>:80
#   backend API (only needed directly for debugging) -> http://<this-machine-ip>:8000
# If port 80 is already taken on this machine, edit `listen 80;` in
# frontend/nginx.conf and rebuild the frontend image instead.
