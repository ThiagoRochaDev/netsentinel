[Unit]
Description=Publish netsentinel.local mDNS alias for the NetSentinel dashboard
After=network-online.target

[Service]
Type=simple
ExecStart=%h/netsentinel/scripts/publish_mdns_alias.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
